# Every environment variable the project reads. No real secrets: there are none.
# The backend reads real environment variables (there is no .env loader), and every
# backend variable has a working default, so local setup needs no backend env file.

# ---- Backend (FastAPI, backend/) ----

# Path to the JSONL dataset. Optional. Default: data/runs.jsonl at the repo root.
# DATA_PATH=../data/runs.jsonl

# Which explain provider to use. Only "mock" exists (deterministic text, no API key).
EXPLAIN_PROVIDER=mock

# Pause between streamed words in the mock provider, in milliseconds.
EXPLAIN_MOCK_DELAY_MS=40

# Extra browser origins allowed to call the API, comma-separated, exact match,
# no trailing slash. http://localhost:3000 is always allowed.
# On Render: the production Vercel URL, e.g. https://your-app.vercel.app
CORS_ORIGINS=

# ---- Frontend (Next.js, frontend/) ----
# Locally these go in frontend/.env.local (copy frontend/.env.example).

# Backend address used by server components (never sent to the browser).
API_URL=http://localhost:8000

# Backend address used by the browser for the streaming Explain call.
# NEXT_PUBLIC_ values are baked in at build time: change it, then rebuild/redeploy.
NEXT_PUBLIC_API_URL=http://localhost:8000
