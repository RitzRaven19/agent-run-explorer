# Copy to .env.local for local development: Copy-Item .env.example .env.local
# (macOS/Linux: cp .env.example .env.local)

# Backend address used by server components (never sent to the browser).
API_URL=http://localhost:8000

# Backend address used by the browser for the streaming Explain call.
# NEXT_PUBLIC_ values are baked in at build time: change it, then rebuild/redeploy.
NEXT_PUBLIC_API_URL=http://localhost:8000
